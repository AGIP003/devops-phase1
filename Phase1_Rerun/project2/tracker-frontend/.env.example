# Flask API base URL. Frontend calls append /auth, /transactions, and so on.
VITE_API_URL=http://127.0.0.1:5000/api

# Public Google OAuth Web client ID. This is an identifier, not a secret.
VITE_GOOGLE_CLIENT_ID=replace-with-web-client-id.apps.googleusercontent.com

# Keep password recovery hidden until production email delivery is available.
VITE_PASSWORD_RESET_ENABLED=false
